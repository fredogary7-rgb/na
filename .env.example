# ============================================================
# NAMARA — variables d'environnement (exemple)
# Copiez ce fichier vers `.env` et renseignez les valeurs.
# Ne committez jamais le fichier `.env` (voir .gitignore).
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=changez-moi-avec-une-valeur-aleatoire-longue

# Base de données (PostgreSQL en production)
# Format SQLAlchemy : postgresql+psycopg2://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=sqlite:///namara_dev.db

# Paramètres financiers (montants en FCFA, entiers)
MIN_DEPOSIT=3000
MIN_WITHDRAWAL=1500
BONUS_INSCRIPTION=0
BONUS_ENABLED=false

# Parrainage (désactivé tant que la conformité n'est pas validée)
REFERRAL_ENABLED=false

# Investissements (désactivés tant qu'aucun produit n'est approuvé)
INVESTMENTS_ENABLED=false

# Paiements : "mock" (simulation explicite) ou "soleaspay"
PAYMENT_MODE=mock

# SoleasPay — à adapter à la documentation officielle du prestataire
# Aucune valeur secrète ne doit figurer ici ni dans le code source.
SOLEASPAY_API_KEY=
SOLEASPAY_API_SECRET=
SOLEASPAY_BASE_URL=
SOLEASPAY_WEBHOOK_SECRET=

# Support client — Telegram (bot @narama_bot)
# Créez un NOUVEAU token dans BotFather (@BotFather) si l'ancien a été divulgué.
# Ne mettez jamais un token réel ici ni dans le code source.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ADMIN_CHAT_ID=
# off (désactivé) / webhook (production HTTPS) / polling (développement local)
TELEGRAM_MODE=off
SUPPORT_ATTACHMENT_MAX_BYTES=2000000
SUPPORT_MESSAGE_MAX_LENGTH=2000

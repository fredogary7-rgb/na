# ============================================================
# NAMARA — variables d'environnement (exemple)
# Copiez ce fichier vers `.env` et renseignez les valeurs.
# Ne committez jamais le fichier `.env` (voir .gitignore).
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=changez-moi-avec-une-valeur-aleatoire-longue

# Base de données (PostgreSQL en production)
# Format SQLAlchemy : postgresql+psycopg2://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=sqlite:///namara_dev.db

# Paramètres financiers (montants en FCFA, entiers)
MIN_DEPOSIT=3000
MIN_WITHDRAWAL=1500
BONUS_INSCRIPTION=0
BONUS_ENABLED=false

# Parrainage (désactivé tant que la conformité n'est pas validée)
REFERRAL_ENABLED=false

# Investissements (désactivés tant qu'aucun produit n'est approuvé)
INVESTMENTS_ENABLED=false

# Catalogue produits — simulation hypothétique (NON validée)
# Le taux quotidien est purement indicatif et ne constitue pas un rendement.
SIMULATION_DAILY_RATE=0.08
SIMULATION_SHOW_AMOUNTS=true
# Souscriptions réelles : bloquées tant que le modèle économique n'est pas validé.
SUBSCRIPTIONS_ENABLED=false

# Versement quotidien des revenus (planificateur scheduler.py)
DAILY_PAYOUT_HOUR=0
DAILY_PAYOUT_MINUTE=5

# Paiements : "mock" (simulation explicite) ou "soleaspay"
PAYMENT_MODE=mock

# SoleasPay v3 — https://doc.mysoleas.com/soleaspay-v3/
SOLEASPAY_API_KEY=
SOLEASPAY_API_SECRET=
SOLEASPAY_BASE_URL=https://soleaspay.com
SOLEASPAY_WEBHOOK_SECRET=

# DrimPay v2 — https://drimpay.com/fr/docs/payin
DRIMPAY_API_KEY=
DRIMPAY_WEBHOOK_SECRET=
DRIMPAY_BASE_URL=https://drimpay.com/api/v2
DRIMPAY_WEBHOOK_URL=https://namara.win/payments/webhook/drimpay

# RobotPay / WestPay (Niger) — https://westpay.cfd
ROBOTPAY_API_KEY=
ROBOTPAY_WEBHOOK_SECRET=
ROBOTPAY_MERCHANT_SLUG=
ROBOTPAY_BASE_URL=https://westpay.cfd
ROBOTPAY_CHECKOUT_URL=https://checkout1.westpay.cfd/pay
ROBOTPAY_RETURN_URL=https://namara.win/payments/robotpay/return

# Support client — Telegram (bot @narama_bot)
# Créez un NOUVEAU token dans BotFather (@BotFather) si l'ancien a été divulgué.
# Ne mettez jamais un token réel ici ni dans le code source.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# URL HTTPS publique du webhook (ex. https://namara.win/support/telegram/webhook)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ADMIN_CHAT_ID=
# off (désactivé) / webhook (production HTTPS) / polling (développement local)
TELEGRAM_MODE=off
SUPPORT_ATTACHMENT_MAX_BYTES=2000000
SUPPORT_MESSAGE_MAX_LENGTH=2000

# Fournisseur d'IA optionnel (niveau 3 du support). Laissez vide pour le désactiver.
# L'IA reçoit uniquement le contexte factuel du site ; elle n'exécute aucune opération.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=10
